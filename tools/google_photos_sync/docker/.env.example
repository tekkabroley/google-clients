# Google Photos Sync - Docker Environment Variables
# Copy this file to .env and customize for your setup

# Rclone Configuration
RCLONE_REMOTE=google_photos
RCLONE_ALBUM=AutoSync
RCLONE_CONFIG=/app/data/config/rclone.conf

# Directory Paths
WATCH_DIR=/app/data/Watch
UPLOADED_DIR=/app/data/Uploaded
LOG_DIR=/app/data/Logs
CONFIG_FILE=/app/data/config/config.env

# Debounce Settings
DEBOUNCE_SLEEP=3
MAX_DEBOUNCE_ATTEMPTS=20

# Rclone Options
RCLONE_OPTIONS=--progress --fast-list

# Debug Mode
DEBUG=false
